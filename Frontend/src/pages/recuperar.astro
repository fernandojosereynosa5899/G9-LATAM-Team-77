---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Recuperar Contraseña | FinanceAI">
	<div class="min-h-[calc(100vh-73px)] flex flex-col justify-center items-center p-6 bg-white dark:bg-gray-950">
		<div class="max-w-md w-full space-y-8 bg-gray-50 dark:bg-gray-900 p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800">
			<div class="text-center">
				<h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Recuperar Contraseña</h2>
				<p class="text-sm text-gray-500 mt-2">Ingresa tu correo y te enviaremos un código para restablecer tu contraseña.</p>
			</div>

			<div id="alertBox" class="hidden p-3.5 rounded-xl text-sm font-medium"></div>

			<!-- Paso 1: Pedir Correo -->
			<form id="recoverForm" class="space-y-4">
				<div>
					<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Correo electrónico</label>
					<input type="email" id="email" required placeholder="tu@correo.com"
						class="w-full px-3.5 py-2.5 text-sm bg-white dark:bg-gray-950 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
				</div>
				<button type="submit" id="sendCodeBtn"
					class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 text-center text-sm shadow-sm">
					Enviar Código
				</button>
			</form>

			<!-- Paso 2: Verificar Código y Nueva Contraseña -->
			<form id="verifyForm" class="hidden space-y-4">
				<div class="text-center mb-2">
					<p class="text-xs text-gray-500">Ingresa el código enviado a tu correo y tu nueva contraseña.</p>
				</div>
				<div>
					<input type="text" id="securityCode" required placeholder="CÓDIGO DE 6 DÍGITOS" maxlength="6"
						class="w-full text-center tracking-[0.2em] font-mono text-xl px-3.5 py-3 bg-white dark:bg-gray-950 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-600 dark:text-white transition" />
				</div>
				<div>
					<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Nueva Contraseña</label>
					<input type="password" id="newPassword" required placeholder="••••••••"
						class="w-full px-3.5 py-2.5 text-sm bg-white dark:bg-gray-950 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
				</div>
				<button type="submit" id="resetBtn"
					class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 text-center text-sm shadow-sm">
					Restablecer Contraseña
				</button>
			</form>

			<div class="text-center">
				<a href="/login" class="text-sm font-medium text-blue-600 hover:underline">Volver a iniciar sesión</a>
			</div>
		</div>
	</div>
</Layout>

<script is:inline>
	const recoverForm = document.getElementById('recoverForm');
	const verifyForm = document.getElementById('verifyForm');
	const sendCodeBtn = document.getElementById('sendCodeBtn');
	const resetBtn = document.getElementById('resetBtn');
	const alertBox = document.getElementById('alertBox');
	
	function showAlert(msg, isError = true) {
		alertBox.className = `p-3.5 rounded-xl text-xs font-medium ${isError ? 'bg-red-50 text-red-700 border-red-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'}`;
		alertBox.textContent = msg;
		alertBox.classList.remove('hidden');
	}

	let savedEmail = '';

	recoverForm.addEventListener('submit', async (e) => {
		e.preventDefault();
		alertBox.classList.add('hidden');
		savedEmail = document.getElementById('email').value.trim();
		sendCodeBtn.disabled = true;
		sendCodeBtn.textContent = 'Enviando...';

		try {
			const res = await fetch('/api/auth/send-code', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: savedEmail, type: 'recovery' })
			});
			const data = await res.json();
			
			if (res.ok) {
				showAlert('Código enviado a tu correo.', false);
				recoverForm.classList.add('hidden');
				verifyForm.classList.remove('hidden');
			} else {
				showAlert(data.error || 'Error enviando el correo.');
			}
		} catch (e) {
			showAlert('Fallo de conexión.');
		} finally {
			sendCodeBtn.disabled = false;
			sendCodeBtn.textContent = 'Enviar Código';
		}
	});

	verifyForm.addEventListener('submit', async (e) => {
		e.preventDefault();
		alertBox.classList.add('hidden');
		const code = document.getElementById('securityCode').value.trim();
		const newPassword = document.getElementById('newPassword').value;

		resetBtn.disabled = true;
		resetBtn.textContent = 'Verificando...';

		try {
			// 1. Validar el código
			const verifyRes = await fetch('/api/auth/verify-code', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: savedEmail, code })
			});
			const verifyData = await verifyRes.json();

			if (!verifyRes.ok) {
				showAlert(verifyData.error || 'Código incorrecto o expirado.');
				resetBtn.disabled = false;
				resetBtn.textContent = 'Restablecer Contraseña';
				return;
			}

			// 2. Si el código es válido, cambiamos la contraseña en Spring Boot
			const BACKEND_URL = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') ? 'http://localhost:8080' : '';
			const resetRes = await fetch(`${BACKEND_URL}/api/v1/auth/reset-password`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: savedEmail, newPassword })
			});

			if (resetRes.ok) {
				showAlert('¡Contraseña restablecida con éxito!', false);
				setTimeout(() => { window.location.href = '/'; }, 2000);
			} else {
				showAlert('Hubo un error guardando tu nueva contraseña. Tal vez el correo no existe.');
			}
		} catch (e) {
			showAlert('Fallo de conexión.');
		} finally {
			resetBtn.disabled = false;
			resetBtn.textContent = 'Restablecer Contraseña';
		}
	});
</script>
